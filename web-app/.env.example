# Copy to web-app/.env and fill in values from Firebase console (Project settings)
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google AI Studio: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Optional override (default in code: gemini-2.5-flash). See https://ai.google.dev/gemini-api/docs/models/gemini
# VITE_GEMINI_MODEL=gemini-2.5-flash

# Optional: Static map previews on meetup detail
# VITE_GOOGLE_MAPS_API_KEY=
