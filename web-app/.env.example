# Copy to web-app/.env and fill in values from Firebase console (Project settings)
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google AI Studio: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Optional override (default in code: gemini-2.5-flash). See https://ai.google.dev/gemini-api/docs/models/gemini
# VITE_GEMINI_MODEL=gemini-2.5-flash
# If you see 503 "high demand", try: gemini-2.0-flash or gemini-1.5-flash

# Optional: Interactive map on meetup detail (enable Maps JavaScript API)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Public URL for share links & QR (use your LAN IP when demoing on stage)
VITE_APP_URL=
