rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /meetups/{meetupId} {
      // Hackathon demo: allow public viewing via QR (/m/:id landing page).
      // Keep writes/auth checks to prevent anonymous spam.
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.creatorId == request.auth.uid;

      match /liveLocations/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /participants/{uid} {
        // Participant can read their own pass; organizer can read all passes.
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          request.auth.uid == get(/databases/$(database)/documents/meetups/$(meetupId)).data.creatorId
        );

        // A participant creates their own pass on join. The code is immutable.
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.code is string
          && request.resource.data.checkedIn == false;

        // Only the organizer can flip check-in; the code must not change.
        allow update: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/meetups/$(meetupId)).data.creatorId
          && request.resource.data.code == resource.data.code;

        // Participant can delete their own pass when leaving.
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
