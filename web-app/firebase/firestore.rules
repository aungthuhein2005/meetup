rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function meetup(meetupId) {
      return get(/databases/$(database)/documents/meetups/$(meetupId)).data;
    }

    function isOrganizer(data) {
      return signedIn() && data.creatorId == request.auth.uid;
    }

    function isParticipant(data) {
      return signedIn() && request.auth.uid in data.participants;
    }

    match /users/{userId} {
      // Profiles contain email and saved coordinates, so they are private.
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /meetups/{meetupId} {
      // Hackathon demo: allow public viewing via QR (/m/:id landing page).
      // Keep writes/auth checks to prevent anonymous spam.
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.participants == [request.auth.uid]
        && request.resource.data.participantCount == 1
        && request.resource.data.maxParticipants >= 2
        && request.resource.data.status == 'active';

      // Organizers may edit their event, but ownership and creation time are
      // immutable. Participants may only add/remove themselves and the matching
      // counter; they cannot edit somebody else's event details.
      allow update: if (
          isOrganizer(resource.data)
          && request.resource.data.creatorId == resource.data.creatorId
          && request.resource.data.createdAt == resource.data.createdAt
        ) || (
          signedIn()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['participants', 'participantCount'])
          && (
            (
              !(request.auth.uid in resource.data.participants)
              && request.auth.uid in request.resource.data.participants
              && request.resource.data.participants.size() == resource.data.participants.size() + 1
              && request.resource.data.participants.hasAll(resource.data.participants)
              && request.resource.data.participantCount == resource.data.participantCount + 1
              && request.resource.data.participantCount <= resource.data.maxParticipants
            ) || (
              request.auth.uid in resource.data.participants
              && !(request.auth.uid in request.resource.data.participants)
              && request.auth.uid != resource.data.creatorId
              && request.resource.data.participants.size() == resource.data.participants.size() - 1
              && resource.data.participants.hasAll(request.resource.data.participants)
              && request.resource.data.participantCount == resource.data.participantCount - 1
            )
          )
        );
      allow delete: if isOrganizer(resource.data);

      match /liveLocations/{uid} {
        allow read: if signedIn() && (
          isOrganizer(meetup(meetupId)) || isParticipant(meetup(meetupId))
        );
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && meetup(meetupId).locationSharingEnabled == true
          && isParticipant(meetup(meetupId))
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.lat >= -90
          && request.resource.data.lat <= 90
          && request.resource.data.lng >= -180
          && request.resource.data.lng <= 180;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /participants/{uid} {
        // Participant can read their own pass; organizer can read all passes.
        allow read: if signedIn() && (
          request.auth.uid == uid ||
          isOrganizer(meetup(meetupId))
        );

        // A participant creates their own pass on join. The code is immutable.
        allow create: if signedIn()
          && request.auth.uid == uid
          && isParticipant(meetup(meetupId))
          && request.resource.data.code is string
          && request.resource.data.checkedIn == false;

        // Only the organizer can flip check-in; the code must not change.
        allow update: if isOrganizer(meetup(meetupId))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['checkedIn', 'checkedInAt', 'checkedInBy'])
          && request.resource.data.code == resource.data.code
          && request.resource.data.checkedIn == true
          && request.resource.data.checkedInBy == request.auth.uid;

        // Participant can delete their own pass when leaving.
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }
  }
}
